[run]
branch = True
source = handwave
omit =
    handwave/__init__.py
    handwave/*/__init__.py

[report]
show_missing = True
skip_covered = True
precision = 1
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError

[html]
directory = test-results/coverage-html

[xml]
output = test-results/coverage.xml
